#!/bin/bash
# ==============================================================================
# AEOS: Autonomous AI Linkage Adapter (Claude Code <-> Antigravity Core)
# ==============================================================================

WORKSPACE_DIR="$(pwd)"
PLANNING_DIR="$WORKSPACE_DIR/.planning"
PID_FILE="$PLANNING_DIR/aeosd.pid"
LEDGER_FILE="$PLANNING_DIR/task_plan.md"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Colors for terminal output
GREEN='\033[0;32m'
RED='\033[0;31m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

init_workspace() {
    echo -e "${BLUE}[AEOS] Initializing secure workspace at $WORKSPACE_DIR...${NC}"
    mkdir -p "$PLANNING_DIR"
    mkdir -p "$WORKSPACE_DIR/dist"
    
    if [ ! -f "$LEDGER_FILE" ]; then
        echo -e "${YELLOW}[AEOS] No task_plan.md found. Creating atomic plan ledger...${NC}"
        cat <<EOF > "$LEDGER_FILE"
# AEOS Master Task Plan
- [ ] Initialize system specifications and directory structure
- [ ] Configure local Qdrant Vector Store indexing
- [ ] Deploy Sandbox execution containers
EOF
    fi
}

start_daemon() {
    init_workspace
    
    if [ -f "$PID_FILE" ] && kill -0 $(cat "$PID_FILE") 2>/dev/null; then
        echo -e "${YELLOW}[AEOS] Linkage system is already active (PID: $(cat "$PID_FILE")).${NC}"
        exit 0
    fi

    echo -e "${GREEN}[AEOS] Activating active linkage pipeline...${NC}"
    
    # 1. Start local Qdrant Vector Storage for Book Library
    docker run -d -p 6333:6333 -p 6334:6334 --name aeos-books qdrant/qdrant >/dev/null 2>&1 || true
    
    # 2. Spawn the Stealth Browser Headless Instance (Playwright MCP)
    BROWSER_SCRIPT="/usr/local/bin/aeos-stealth-browser.js"
    [ ! -f "$BROWSER_SCRIPT" ] && BROWSER_SCRIPT="$SCRIPT_DIR/aeos-stealth-browser.js"
    node "$BROWSER_SCRIPT" --daemon > /dev/null 2>&1 &

    # 3. Boot background IPC Sync Loop (watches task_plan.md and routes to Antigravity)
    ORCH_SCRIPT="/usr/local/bin/aeos-orchestrator.js"
    [ ! -f "$ORCH_SCRIPT" ] && ORCH_SCRIPT="$SCRIPT_DIR/aeos-orchestrator.js"
    node "$ORCH_SCRIPT" --watch > "$PLANNING_DIR/aeosd.log" 2>&1 &
    echo $! > "$PID_FILE"
    
    echo -e "${GREEN}[AEOS] Linkage successful! Claude Code and Antigravity are now hardwired.${NC}"
    echo -e "${BLUE}[AEOS] Shared session logs active in tmux panel. Run 'tmux attach-session -t aeos' to watch.${NC}"
}

stop_daemon() {
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        echo -e "${RED}[AEOS] Breaking agent linkages and stopping services (PID: $PID)...${NC}"
        kill "$PID" 2>/dev/null
        rm -f "$PID_FILE"
        docker stop aeos-books >/dev/null 2>&1 || true
        pkill -f aeos-stealth-browser.js || true
        echo -e "${RED}[AEOS] System safely offline.${NC}"
    else
        echo -e "${YELLOW}[AEOS] No active linkage detected.${NC}"
    fi
}

case "$1" in
    start|/aeos|--activate)
        start_daemon
        ;;
    stop|--deactivate)
        stop_daemon
        ;;
    claim|--claim-pending)
        ORCH_SCRIPT="/usr/local/bin/aeos-orchestrator.js"
        [ ! -f "$ORCH_SCRIPT" ] && ORCH_SCRIPT="$SCRIPT_DIR/aeos-orchestrator.js"
        node "$ORCH_SCRIPT" --claim-pending
        ;;
    *)
        start_daemon
        ;;
esac