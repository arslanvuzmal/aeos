{
  "hooks": {
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "./.claude/hooks/smart_inject.sh"
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "./aeos-attest --verify"
          }
        ]
      }
    ]
  }
}